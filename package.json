{
  "name": "mereader-lite",
  "productName": "MeReader-Lite",
  "version": "1.0.0",
  "description": "轻量级 Markdown 阅读器与编辑器",
  "author": "啊坤 <akun666yyds@gmail.com>",
  "copyright": "Copyright © 2026 啊坤",
  "license": "MIT",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "icon": "node scripts/build-icon.js",
    "dist": "electron-builder --win"
  },
  "build": {
    "appId": "com.akun.mereader-lite",
    "productName": "MeReader-Lite",
    "copyright": "Copyright © 2026 啊坤",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "assets/icon.ico",
      "assets/icon.png",
      "package.json"
    ],
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ]
    },
    "portable": {
      "artifactName": "${productName}-Portable-${version}.exe"
    }
  },
  "dependencies": {
    "@highlightjs/cdn-assets": "^11.9.0",
    "dompurify": "^3.1.6",
    "marked": "^12.0.2"
  },
  "devDependencies": {
    "electron": "^31.3.1",
    "electron-builder": "^26.15.3",
    "png2icons": "^2.0.1",
    "sharp": "^0.33.4"
  }
}
