{
  "name": "mereader",
  "productName": "MeReader",
  "version": "1.1.0",
  "description": "本地 Markdown 读写工具，内置 Ollama 驱动的 Ollab 助手",
  "author": "啊坤 <akun666yyds@gmail.com>",
  "copyright": "Copyright © 2026 啊坤",
  "license": "MIT",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "icon": "node scripts/build-icon.js",
    "dist": "electron-builder --win",
    "test": "node scripts/selftest-workspace.js && node scripts/selftest-markdown.js && node scripts/selftest-engine.js",
    "test:agent": "node scripts/selftest-engine.js",
    "test:e2e": "node scripts/e2e-ollama.js",
    "smoke": "electron scripts/smoke.js",
    "screenshot": "electron scripts/screenshot.js"
  },
  "build": {
    "appId": "com.akun.mereader",
    "productName": "MeReader",
    "copyright": "Copyright © 2026 啊坤",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "assets/icon.ico",
      "assets/icon.png",
      "package.json"
    ],
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ]
    },
    "portable": {
      "artifactName": "${productName}-Portable-${version}.exe"
    }
  },
  "dependencies": {
    "@highlightjs/cdn-assets": "^11.9.0",
    "dompurify": "^3.1.6",
    "marked": "^12.0.2"
  },
  "devDependencies": {
    "electron": "^31.3.1",
    "electron-builder": "^26.15.3",
    "png2icons": "^2.0.1",
    "sharp": "^0.33.4"
  }
}
